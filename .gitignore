# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment variables (strictly protected)
.env
.env.local
.env.*

# Large raw raw data downloads
data/raw/*
!data/raw/.gitkeep

# Allow processed data and serialized models for Streamlit deployment
!data/processed/clean_data.csv
!models/*.pkl

# Streamlit
.streamlit/

# IDE files
.vscode/
.idea/
*.swp
